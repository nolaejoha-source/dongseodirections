{
  "name": "dsu-campus-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "android:sync": "npm run build && npx cap sync android && node scripts/prepare-android-build.mjs",
    "android:apk": "npm run build && npx cap sync android && node scripts/prepare-android-build.mjs && cd android && gradlew.bat assembleDebug && cd .. && node -e \"require('node:fs').copyFileSync('android/app/build/outputs/apk/debug/app-debug.apk', 'dongseo-campus-map-debug.apk')\"",
    "android:open": "npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/geolocation": "^8.2.5",
    "@types/three": "^0.187.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/leaflet": "^1.9.15",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "~5.6.2",
    "vite": "^5.4.11"
  }
}
